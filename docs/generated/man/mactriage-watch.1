.nh
.TH "MACTRIAGE" "1" "Dec 1969" "mactriage" "mactriage Manual"

.SH NAME
mactriage-watch - Watch a process for descriptor growth and resource errors


.SH SYNOPSIS
\fBmactriage watch [process-or-pid] [flags]\fP


.SH DESCRIPTION
Watch a process for descriptor growth and resource errors


.SH OPTIONS
\fB--cpu-threshold\fP=80
	warn at this process CPU percentage

.PP
\fB--duration\fP=0s
	stop after this duration (zero runs until interrupted)

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for watch

.PP
\fB--include-paths\fP[=false]
	include target-process path aggregation in watch events

.PP
\fB--interval\fP=5s
	sampling interval

.PP
\fB--memory-free-threshold\fP=10
	warn when system free memory reaches this percentage

.PP
\fB--memory-threshold-mib\fP=4096
	warn at this resident-memory size in MiB

.PP
\fB--sockets-threshold\fP=1000
	warn at this socket count

.PP
\fB--threads-threshold\fP=500
	warn at this thread count

.PP
\fB--warn-growth\fP=150
	warn after this many additional descriptors within the window

.PP
\fB--window\fP=1m0s
	rolling growth window


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--accessible\fP[=false]
	use screen-reader-friendly prompts and static progress

.PP
\fB--animation\fP="auto"
	animation mode: auto, always, or never

.PP
\fB--color\fP="auto"
	color mode: auto, always, or never

.PP
\fB--fail-on\fP="error"
	return exit 1 at this severity: warning, error, or critical

.PP
\fB--json\fP[=false]
	emit versioned JSON (NDJSON for watch)

.PP
\fB--offline\fP[=false]
	skip checks that require network access

.PP
\fB-o\fP, \fB--output\fP=""
	write the command's private report or artifact to PATH

.PP
\fB--plain\fP[=false]
	disable color, animation, and terminal UI control sequences

.PP
\fB--redact\fP="standard"
	report redaction: standard or strict

.PP
\fB--timeout\fP=15s
	timeout for each macOS evidence command

.PP
\fB--total-timeout\fP=0s
	maximum total command duration (0 disables the overall limit)

.PP
\fB-v\fP, \fB--verbose\fP[=false]
	show the macOS commands being run on stderr


.SH SEE ALSO
\fBmactriage(1)\fP
