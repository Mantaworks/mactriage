.nh
.TH "MACTRIAGE" "1" "Dec 1969" "mactriage" "mactriage Manual"

.SH NAME
mactriage-storage - Explain startup-disk capacity by safe aggregate category


.SH SYNOPSIS
\fBmactriage storage [flags]\fP


.SH DESCRIPTION
Explain startup-disk capacity by safe aggregate category


.SH OPTIONS
\fB--details\fP[=false]
	measure aggregate sizes for standard storage categories

.PP
\fB--fix\fP[=false]
	offer an eligible safe follow-through action

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for storage


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--accessible\fP[=false]
	use screen-reader-friendly prompts and static progress

.PP
\fB--animation\fP="auto"
	animation mode: auto, always, or never

.PP
\fB--color\fP="auto"
	color mode: auto, always, or never

.PP
\fB--fail-on\fP="error"
	return exit 1 at this severity: warning, error, or critical

.PP
\fB--json\fP[=false]
	emit versioned JSON (NDJSON for watch)

.PP
\fB--offline\fP[=false]
	skip checks that require network access

.PP
\fB-o\fP, \fB--output\fP=""
	write the command's private report or artifact to PATH

.PP
\fB--plain\fP[=false]
	disable color, animation, and terminal UI control sequences

.PP
\fB--redact\fP="standard"
	report redaction: standard or strict

.PP
\fB--timeout\fP=15s
	timeout for each macOS evidence command

.PP
\fB--total-timeout\fP=0s
	maximum total command duration (0 disables the overall limit)

.PP
\fB-v\fP, \fB--verbose\fP[=false]
	show the macOS commands being run on stderr


.SH SEE ALSO
\fBmactriage(1)\fP
