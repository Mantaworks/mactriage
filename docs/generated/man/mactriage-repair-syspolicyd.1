.nh
.TH "MACTRIAGE" "1" "Dec 1969" "mactriage" "mactriage Manual"

.SH NAME
mactriage-repair-syspolicyd - Restart syspolicyd and verify launchd relaunches it


.SH SYNOPSIS
\fBmactriage repair syspolicyd [flags]\fP


.SH DESCRIPTION
Restart syspolicyd and verify launchd relaunches it


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for syspolicyd

.PP
\fB--yes\fP[=false]
	confirm the explicit repair without an interactive prompt


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--accessible\fP[=false]
	use screen-reader-friendly prompts and static progress

.PP
\fB--animation\fP="auto"
	animation mode: auto, always, or never

.PP
\fB--color\fP="auto"
	color mode: auto, always, or never

.PP
\fB--json\fP[=false]
	emit versioned JSON (NDJSON for watch)

.PP
\fB-o\fP, \fB--output\fP=""
	also write a sanitized JSON report to PATH

.PP
\fB--plain\fP[=false]
	disable color, animation, and terminal UI control sequences

.PP
\fB--timeout\fP=15s
	timeout for each macOS evidence command

.PP
\fB-v\fP, \fB--verbose\fP[=false]
	show the macOS commands being run on stderr


.SH SEE ALSO
\fBmactriage-repair(1)\fP
