Output docs/assets/mactriage-demo.gif
Set Shell "zsh"
Set FontSize 18
Set Width 1100
Set Height 720
Set Theme { "background": "#10131A", "foreground": "#E7ECF4", "black": "#10131A", "red": "#FF6B7A", "green": "#68D391", "yellow": "#F6C85F", "blue": "#72A7FF", "magenta": "#C792EA", "cyan": "#69D2E7", "white": "#E7ECF4", "brightBlack": "#64748B", "brightRed": "#FF8792", "brightGreen": "#86E3A8", "brightYellow": "#FFD978", "brightBlue": "#8CB9FF", "brightMagenta": "#D7A6F3", "brightCyan": "#8BE1EF", "brightWhite": "#FFFFFF" }
Set TypingSpeed 35ms
Set PlaybackSpeed 1.15

Type "./bin/mactriage doctor --quick --color always --animation always"
Enter
Sleep 9s
